<Window x:Class="DataMonitor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataMonitor" Width="1200" Height="700" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,28,18,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,6">
                        <Border Background="{StaticResource BlueTintBrush}" CornerRadius="9" Width="36" Height="36" Margin="0,0,10,0">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="DataMonitor" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="YOUR NETWORK, AT A GLANCE" Style="{StaticResource Eyebrow}" Margin="10,8,0,28"/>
                    <RadioButton x:Name="DashboardNav" Content="Dashboard" Tag="&#xE80F;" GroupName="Navigation"
                                 Style="{StaticResource NavigationItem}" Click="Dashboard_Click" AutomationProperties.Name="Dashboard"/>
                    <RadioButton x:Name="HistoryNav" Content="History" Tag="&#xE81C;" GroupName="Navigation"
                                 Style="{StaticResource NavigationItem}" Click="History_Click" AutomationProperties.Name="History"/>
                    <RadioButton x:Name="SettingsNav" Content="Settings" Tag="&#xE713;" GroupName="Navigation"
                                 Style="{StaticResource NavigationItem}" Click="Settings_Click" AutomationProperties.Name="Settings"/>
                </StackPanel>
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14" x:Name="MonitoringPanel">
                    <StackPanel>
                        <TextBlock Text="LAST OBSERVED ADAPTER" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" Foreground="{StaticResource TealBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding AdapterDisplayName}" FontWeight="SemiBold" MaxWidth="130" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource ConnectionStatus}" Margin="0,8,0,0"/>
                        <TextBlock Text="Updated on Dashboard" Style="{StaticResource Caption}" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid>
                    <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                    <TextBlock Text="Windows network utility" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" x:Name="DashboardContainer"/>
        </Grid>
    </Grid>
</Window>

